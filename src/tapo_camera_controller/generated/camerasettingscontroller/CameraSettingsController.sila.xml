<Feature xmlns="http://www.sila-standard.org" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Category="instruments" FeatureVersion="1.0" MaturityLevel="Draft" Originator="org.riken" SiLA2Version="1.0" xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
  <Identifier>CameraSettingsController</Identifier>
  <DisplayName>Camera Settings Controller</DisplayName>
  <Description>Image adjustment and main-stream resolution of the camera (via ONVIF Imaging / Media).

    IMPORTANT: these are settings of the camera itself. They are stored in the camera, apply to
    every client (including the Tapo app live view and other recordings) and remain after the
    server stops.

    Image adjustment (verified on Tapo C232):
      ColorSaturation: 0 = grayscale, 50 = default, 100 = most saturated. Clearly effective.
      Contrast       : 0 to 100, 50 = default. Effective (moderate change).
      Sharpness      : 0 to 100, 50 = default. Weak effect (slightly stronger edges at 100).
      Not offered: brightness, video bit rate and encoding quality. The Tapo C232 accepts these
      over ONVIF but they have no effect, so they are deliberately not exposed.
      Day/night (infrared) mode, exposure, white balance and image flip are not available via ONVIF
      on the Tapo C232; use the Tapo app for those.

    Main stream resolution:
      The "Main" stream of VideoCaptureController can be switched between the resolutions listed in
      AvailableMainStreamResolutions (Tapo C232: 2880 x 1620 and 1920 x 1080). Lower resolution
      means smaller recordings (Tapo C232: about 1.7 Mbit/s at 2880 x 1620, about 0.8 Mbit/s at
      1920 x 1080). The "Sub" stream is fixed (640 x 360).
      Changing the resolution restarts the camera's video streams for a few seconds, so it is
      rejected while a snapshot or recording is in progress (OperationInProgress).</Description>
  <Command>
    <Identifier>SetImageSettings</Identifier>
    <DisplayName>Set Image Settings</DisplayName>
    <Description>Set color saturation, contrast and sharpness (all three at once; read ImageSettings first to keep
      a value unchanged). Returns the values read back from the camera. The change is visible in
      new snapshots and recordings within about 2 seconds.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>ColorSaturation</Identifier>
      <DisplayName>Color Saturation</DisplayName>
      <Description>0 (grayscale) to 100; default 50.</Description>
      <DataType>
        <DataTypeIdentifier>Level</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Contrast</Identifier>
      <DisplayName>Contrast</DisplayName>
      <Description>0 to 100; default 50.</Description>
      <DataType>
        <DataTypeIdentifier>Level</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Sharpness</Identifier>
      <DisplayName>Sharpness</DisplayName>
      <Description>0 to 100; default 50 (weak effect on Tapo C232).</Description>
      <DataType>
        <DataTypeIdentifier>Level</DataTypeIdentifier>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>ImageSettings</Identifier>
      <DisplayName>Image Settings</DisplayName>
      <Description>Settings read back from the camera after the change.</Description>
      <DataType>
        <DataTypeIdentifier>ImageSettings</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>CameraCommunicationError</Identifier>
      <Identifier>InvalidInstrumentStatus</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>ResetImageSettings</Identifier>
    <DisplayName>Reset Image Settings</DisplayName>
    <Description>Set color saturation, contrast and sharpness back to the default 50.</Description>
    <Observable>No</Observable>
    <Response>
      <Identifier>ImageSettings</Identifier>
      <DisplayName>Image Settings</DisplayName>
      <Description>Settings read back from the camera after the change.</Description>
      <DataType>
        <DataTypeIdentifier>ImageSettings</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>CameraCommunicationError</Identifier>
      <Identifier>InvalidInstrumentStatus</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Command>
    <Identifier>SetMainStreamResolution</Identifier>
    <DisplayName>Set Main Stream Resolution</DisplayName>
    <Description>Change the resolution of the "Main" stream to one of AvailableMainStreamResolutions.
      The command returns after the camera has restarted the stream (about 4 seconds).
      Rejected with OperationInProgress while a snapshot or recording is running.</Description>
    <Observable>No</Observable>
    <Parameter>
      <Identifier>Width</Identifier>
      <DisplayName>Width</DisplayName>
      <Description>Width in pixels (e.g. 2880 or 1920 on Tapo C232).</Description>
      <DataType>
        <Basic>Integer</Basic>
      </DataType>
    </Parameter>
    <Parameter>
      <Identifier>Height</Identifier>
      <DisplayName>Height</DisplayName>
      <Description>Height in pixels (e.g. 1620 or 1080 on Tapo C232).</Description>
      <DataType>
        <Basic>Integer</Basic>
      </DataType>
    </Parameter>
    <Response>
      <Identifier>Resolution</Identifier>
      <DisplayName>Resolution</DisplayName>
      <Description>Resolution read back from the camera after the change.</Description>
      <DataType>
        <DataTypeIdentifier>Resolution</DataTypeIdentifier>
      </DataType>
    </Response>
    <DefinedExecutionErrors>
      <Identifier>CameraCommunicationError</Identifier>
      <Identifier>InvalidInstrumentStatus</Identifier>
      <Identifier>UnsupportedResolution</Identifier>
      <Identifier>OperationInProgress</Identifier>
    </DefinedExecutionErrors>
  </Command>
  <Property>
    <Identifier>ImageSettings</Identifier>
    <DisplayName>Image Settings</DisplayName>
    <Description>Current color saturation, contrast and sharpness of the camera.</Description>
    <Observable>No</Observable>
    <DataType>
      <DataTypeIdentifier>ImageSettings</DataTypeIdentifier>
    </DataType>
    <DefinedExecutionErrors>
      <Identifier>CameraCommunicationError</Identifier>
    </DefinedExecutionErrors>
  </Property>
  <Property>
    <Identifier>MainStreamResolution</Identifier>
    <DisplayName>Main Stream Resolution</DisplayName>
    <Description>Current resolution of the "Main" stream.</Description>
    <Observable>No</Observable>
    <DataType>
      <DataTypeIdentifier>Resolution</DataTypeIdentifier>
    </DataType>
    <DefinedExecutionErrors>
      <Identifier>CameraCommunicationError</Identifier>
    </DefinedExecutionErrors>
  </Property>
  <Property>
    <Identifier>AvailableMainStreamResolutions</Identifier>
    <DisplayName>Available Main Stream Resolutions</DisplayName>
    <Description>Resolutions the "Main" stream supports, as reported by the camera.</Description>
    <Observable>No</Observable>
    <DataType>
      <List>
        <DataType>
          <DataTypeIdentifier>Resolution</DataTypeIdentifier>
        </DataType>
      </List>
    </DataType>
    <DefinedExecutionErrors>
      <Identifier>CameraCommunicationError</Identifier>
    </DefinedExecutionErrors>
  </Property>
  <DefinedExecutionError>
    <Identifier>CameraCommunicationError</Identifier>
    <DisplayName>Camera Communication Error</DisplayName>
    <Description>The camera could not be reached or rejected the change. The message contains details.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>InvalidInstrumentStatus</Identifier>
    <DisplayName>Invalid Instrument Status</DisplayName>
    <Description>The command cannot be executed because the status is Not Connected or Error. Use Reset first.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>UnsupportedResolution</Identifier>
    <DisplayName>Unsupported Resolution</DisplayName>
    <Description>The camera does not support this resolution. See AvailableMainStreamResolutions.</Description>
  </DefinedExecutionError>
  <DefinedExecutionError>
    <Identifier>OperationInProgress</Identifier>
    <DisplayName>Operation In Progress</DisplayName>
    <Description>A snapshot or recording is running. Wait for it to finish and retry.</Description>
  </DefinedExecutionError>
  <DataTypeDefinition>
    <Identifier>Level</Identifier>
    <DisplayName>Level</DisplayName>
    <Description>Image adjustment level, 0 to 100 (50 = camera default).</Description>
    <DataType>
      <Constrained>
        <DataType>
          <Basic>Integer</Basic>
        </DataType>
        <Constraints>
          <MinimalInclusive>0</MinimalInclusive>
          <MaximalInclusive>100</MaximalInclusive>
        </Constraints>
      </Constrained>
    </DataType>
  </DataTypeDefinition>
  <DataTypeDefinition>
    <Identifier>ImageSettings</Identifier>
    <DisplayName>Image Settings</DisplayName>
    <Description>Image adjustment values (0 to 100, 50 = default).</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>ColorSaturation</Identifier>
          <DisplayName>Color Saturation</DisplayName>
          <Description>0 = grayscale, 100 = most saturated.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Contrast</Identifier>
          <DisplayName>Contrast</DisplayName>
          <Description>0 to 100.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Sharpness</Identifier>
          <DisplayName>Sharpness</DisplayName>
          <Description>0 to 100.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>
  <DataTypeDefinition>
    <Identifier>Resolution</Identifier>
    <DisplayName>Resolution</DisplayName>
    <Description>A video resolution in pixels.</Description>
    <DataType>
      <Structure>
        <Element>
          <Identifier>Width</Identifier>
          <DisplayName>Width</DisplayName>
          <Description>Width in pixels.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
        <Element>
          <Identifier>Height</Identifier>
          <DisplayName>Height</DisplayName>
          <Description>Height in pixels.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </DataTypeDefinition>
</Feature>
